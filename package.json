{
  "name": "roleplay20",
  "version": "1.0.0",
  "description": "Roleplay20: an AI Dungeon Master and virtual tabletop for D&D 5e. Plays at josephjackman.com/roleplay20",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:srd": "node scripts/build-srd.mjs",
    "build": "node scripts/build-srd.mjs && vite build --config client/vite.config.js",
    "build:client": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "setup": "node scripts/setup.mjs",
    "cloud-setup": "node scripts/cloud-setup.mjs",
    "deploy": "node scripts/cloud-setup.mjs --deploy",
    "test": "node --test \"test/*.test.js\"",
    "unlock": "node scripts/unlock.mjs",
    "stop-tunnel": "node scripts/stop-tunnel.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  }
}
